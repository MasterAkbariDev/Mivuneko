{
  "identifier": "pet-window",
  "description": "The desktop pet: its own state, placement and voice playback only. Cannot launch apps, approve requests, change permissions or read history.",
  "windows": ["pet"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-ignore-cursor-events",
    "allow-cancel-gemini",
    "allow-cancel-voice",
    "allow-character-voice",
    "allow-gemini-speak-stream",
    "allow-get-pet-state",
    "allow-pet-cursor",
    "allow-publish-pet-state",
    "allow-quiet-pet-position",
    "allow-show-pet",
    "allow-sync-pet-displays",
    "allow-synthesize-phrase",
    "allow-synthesize-speech",
    "allow-transcribe-audio",
    "allow-foreground-fullscreen"
  ]
}
